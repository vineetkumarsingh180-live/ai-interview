# ==============================================================================
# Synapse.AI - Centralized Backend Configuration Template
# ==============================================================================

# 1. Database URL: Supports SQLite (e.g. sqlite:///./jobs.db) or PostgreSQL
DATABASE_URL=sqlite:///./jobs.db

# 2. AI Model Selection: any supported Gemini model text (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# 3. Global Platform AI Key: General platform features & Outreach drafting
GEMINI_API_KEY=your_general_gemini_api_key

# 4. Voice Defense Module: Dedicated key for live voice interview assessment & scoring
GEMINI_API_KEY_1=your_voice_defense_gemini_api_key
GEMINI_API_KEY_VOICE_DEFENSE=your_voice_defense_gemini_api_key

# 5. Code Verifier Module: Dedicated key for GitHub code inspection (vulgarity, bugs, advance)
GEMINI_API_KEY_CODE_VERIFIER=your_code_verifier_gemini_api_key

# 6. Job Lead Radar Module: Dedicated key for Job Lead Radar search & matching
GEMINI_API_KEY_JOB_LEAD=your_job_lead_gemini_api_key

# 6. Browser origins allowed to call the API directly
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
