# Copy to backend/.env (git-ignored). Never commit real credentials.

# Isolated Synapse database. Create it with backend/db/setup_local_db.sql (needs superuser approval).
DATABASE_URL=postgresql+asyncpg://synapse_app@localhost:5432/synapse_dev

# Optional: enables AI features (lead parsing, outreach drafts, interview follow-ups).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Browser origins allowed to call the API directly (JSON list).
# CORS_ORIGINS=["http://localhost:5173"]
