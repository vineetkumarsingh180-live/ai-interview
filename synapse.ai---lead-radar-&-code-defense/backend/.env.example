# Centralized Backend Configuration (never committed; see .env.example)

# Database URL: Supports SQLite (e.g. sqlite:///./jobs.db) or PostgreSQL
DATABASE_URL=sqlite:///./jobs.db

# Google Gemini API Configuration:
# - GEMINI_API_KEY: your actual Gemini API key
# - GEMINI_MODEL: any supported Gemini model text (e.g. gemini-2.5-flash, gemini-1.5-pro)
GEMINI_API_KEY=your_actual_api_key
GEMINI_MODEL=your_supported_gemini_model

# Browser origins allowed to call the API directly
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
