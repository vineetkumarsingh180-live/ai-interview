# Copy to .env.local (git-ignored) to override. No secrets belong here: the browser never gets API keys.

# Dev/preview server forwards /api to this FastAPI address.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: call an API on another origin directly instead of using the proxy (needs CORS_ORIGINS on the backend).
# VITE_API_BASE_URL=https://api.example.com
